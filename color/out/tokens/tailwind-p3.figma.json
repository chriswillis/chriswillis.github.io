        {
          "id": "172wsj21a5wbz",
          "name": "content/normal",
          "resolvedType": "COLOR",
          "scopes": [
            "TEXT_FILL"
          ],
          "description": "Primary text: the most contrasting step the ramp has. The thresholds are checked rather than used to select, so the report says whether the darkest step actually reaches AAA — on Radix's dark scale it clears 7:1 easily and reaches Lc 86–96, short of the Lc 90 APCA wants for fluent text in 18 of 25 families. Requirement: WCAG 2.1 SC 1.4.6 Contrast (Enhanced), AAA: 7:1 for body text; APCA-W3 Lc 75, the practical body-text level above bronze.",
          "valuesByMode": {
