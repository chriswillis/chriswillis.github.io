  },
  {
   "name": "icon/normal",
   "radixStep": null,
   "source": "WCAG 2.1 SC 1.4.11 Non-text Contrast, AA: 3:1 for information required to identify a control or its state; APCA-W3 bronze: Lc 60 for body text, Lc 45 for large text, Lc 30 for non-text"
  },
  {
   "name": "content/subtle",
   "radixStep": 11,
   "source": "WCAG 2.1 SC 1.4.3 Contrast (Minimum), AA: 4.5:1 for body text; APCA-W3 bronze: Lc 60 for body text, Lc 45 for large text, Lc 30 for non-text"
  },
  {
   "name": "content/normal",
   "radixStep": 12,
   "source": "WCAG 2.1 SC 1.4.6 Contrast (Enhanced), AAA: 7:1 for body text; APCA-W3 Lc 75, the practical body-text level above bronze"
  },
  {
   "name": "content/on-solid",
   "radixStep": null,
   "source": "WCAG 2.1 SC 1.4.3 Contrast (Minimum), AA: 4.5:1 for body text; APCA-W3 bronze: Lc 60 for body text, Lc 45 for large text, Lc 30 for non-text"
  },
  {
   "name": "content/disabled",
   "radixStep": null,
   "source": "WCAG 2.1 exempts disabled controls from 1.4.3 and 1.4.11, so nothing published applies; the floor here is APCA Lc 30, its spot-reading level — a licence to be quiet, not to disappear"
  }
